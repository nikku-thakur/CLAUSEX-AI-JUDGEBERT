# Google Cloud Translation Advanced (v3) credentials are backend-only.
# Enable the Cloud Translation API and grant the service account permission to translate text.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# English simplification uses OpenAI Responses API. Keep this key on the backend only.
OPENAI_API_KEY=
CLAUSEX_SIMPLIFICATION_MODEL=gpt-5.4-mini
# Use the glossary's location when a glossary is configured; otherwise `global` is fine.
GOOGLE_CLOUD_TRANSLATION_LOCATION=global
# Optional glossary resource, for consistent legal terminology. Its location must match above.
# GOOGLE_CLOUD_TRANSLATION_LOCATION=us-central1
# GOOGLE_CLOUD_TRANSLATION_GLOSSARY=projects/your-google-cloud-project-id/locations/us-central1/glossaries/legal-terms
