# ClauseX AI Environment Configuration
# When NEXT_PUBLIC_API_URL is empty or unreachable, ClauseX automatically
# falls back to the deterministic, rule-based demo engine with transparent notices.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_MODEL_NAME=JUDGEBERT-Multilingual-v1-Demo
NEXT_PUBLIC_APP_ENV=development
